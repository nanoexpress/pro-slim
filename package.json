{
  "name": "@nanoexpress/pro-slim",
  "version": "3.0.0",
  "description": "nanoexpress for enterprise users & teams",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "main": "src/nanoexpress.js",
  "typings": "nanoexpress.d.ts",
  "scripts": {
    "lint": "biome check . && rumdl check .",
    "format": "biome check --write . && rumdl fmt .",
    "test": "node --test tests",
    "cleanup-cjs": "rm -rf cjs/*.js",
    "build": "bun run cleanup-cjs && bun build ./src/nanoexpress.js ./src/route.js ./src/app.js --outdir cjs --format cjs --target node -e uWebSockets.js -e ./route.js -e ./app.js -e events -e http -e zlib -e fs && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run lint && bun run test && bun run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanoexpress/pro-slim.git"
  },
  "keywords": [
    "nano",
    "node",
    "fast",
    "uws",
    "websocket",
    "http",
    "c++"
  ],
  "author": "dalisoft",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/nanoexpress/pro-slim/issues"
  },
  "homepage": "https://github.com/nanoexpress/pro-slim#readme",
  "dependencies": {
    "uWebSockets.js": "https://github.com/uNetworking/uWebSockets.js/archive/refs/tags/v20.70.0.tar.gz"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.3",
    "lefthook": "^2.1.15",
    "rumdl": "^0.2.78",
    "typescript": "^7.0.2"
  }
}
